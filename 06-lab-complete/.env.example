# Local defaults. Copy to .env and set your own AGENT_API_KEY.
# AGENT_API_KEY protects this agent; it is separate from provider API keys.
PORT=8000
ENVIRONMENT=development
AGENT_API_KEY=replace-with-your-own-agent-key
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
